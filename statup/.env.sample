STATUP_IMAGE=ghcr.io/karl-cta/statup:0.4.0
STATUP_BIND=0.0.0.0
STATUP_PORT=3811
TZ=Europe/Warsaw
DEFAULT_LOCALE=en
PUBLIC_MODE=false
TRUST_PROXY_HEADERS=false
PUBLIC_URL=http://192.168.1.2:3811
UPDATE_CHECK=false
MONITORING=true

# Optional initial administrator. Leave unset to create the first admin in the browser.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password

# Optional SMTP for email notifications and password reset links.
# SMTP_HOST=smtp.example.com
# SMTP_SECURITY=starttls
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM="Statup <status@example.com>"
