VERT_PORT=3000
PUB_HOSTNAME=localhost:3000
PUB_ENV=production

# Build-time privacy default: hide Plausible, donation, Stripe, and hosted vertd calls.
PUB_DISABLE_ALL_EXTERNAL_REQUESTS=true
PUB_DISABLE_FAILURE_BLOCKS=true

# Optional: point to a self-hosted vertd instance and set external requests to false.
PUB_VERTD_URL=
PUB_PLAUSIBLE_URL=
PUB_DONATION_URL=
PUB_STRIPE_KEY=
