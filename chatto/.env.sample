# Copy to .env and replace every placeholder before starting Chatto.

PUBLIC_URL=chat.example.com
CHATTO_OWNERS_EMAILS=admin@example.com

PUID=1000
PGID=1000
CHATTO_BACKUP_DIR=./backups

# Official Chatto currently publishes a moving latest image. Revisit this before
# production upgrades and pin a digest if you need strict reproducibility.
CHATTO_IMAGE=ghcr.io/chattocorp/chatto:latest
CHATTO_ENV_FILE=.env

HTTP_PORT=80
HTTPS_PORT=443
LIVEKIT_UDP_PORT=7882
LIVEKIT_TCP_PORT=7881
LIVEKIT_TURN_UDP_PORT=3478

NATS_TOKEN=replace-with-long-random-nats-token

CHATTO_NATS_EMBEDDED_ENABLED=false
CHATTO_NATS_CLIENT_URL=nats://nats:4222
CHATTO_NATS_CLIENT_AUTH_METHOD=token
CHATTO_NATS_CLIENT_TOKEN=replace-with-long-random-nats-token
CHATTO_WEBSERVER_URL=https://chat.example.com
CHATTO_WEBSERVER_PORT=4000
CHATTO_WEBSERVER_COOKIE_SIGNING_SECRET=replace-with-64-hex-chars
CHATTO_WEBSERVER_COOKIE_ENCRYPTION_SECRET=replace-with-64-hex-chars
CHATTO_CORE_SECRET_KEY=replace-with-64-hex-chars
CHATTO_CORE_ASSETS_SIGNING_SECRET=replace-with-64-hex-chars
CHATTO_LOG_LEVEL=info
CHATTO_LOG_FORMAT=json
CHATTO_OPERATOR_API_ENABLED=true
CHATTO_OPERATOR_API_SOCKET_PATH=/tmp/chatto/operator.sock

LIVEKIT_CONFIG_FILE=./livekit.yaml
CHATTO_LIVEKIT_ENABLED=true
CHATTO_LIVEKIT_URL=wss://livekit.chat.example.com
CHATTO_LIVEKIT_API_KEY=chatto
CHATTO_LIVEKIT_API_SECRET=replace-with-at-least-32-character-livekit-secret

# SMTP is required for direct email/password registration, email verification,
# and password reset. JMAP can be used instead; see the post for notes.
CHATTO_SMTP_ENABLED=true
CHATTO_SMTP_HOST=smtp.example.com
CHATTO_SMTP_PORT=587
CHATTO_SMTP_TLS=mandatory
CHATTO_SMTP_USERNAME=replace-with-smtp-username
CHATTO_SMTP_PASSWORD=replace-with-smtp-password
CHATTO_SMTP_FROM=noreply@example.com

# Optional browser push notifications.
# CHATTO_PUSH_ENABLED=true
# CHATTO_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# CHATTO_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
# CHATTO_PUSH_VAPID_SUBJECT=admin@example.com
