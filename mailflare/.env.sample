# Web UI. Put Mailflare behind HTTPS for real mail use.
APP_URL=https://mail.example.com
MAILFLARE_HTTP_BIND=127.0.0.1:3000

# Inbound SMTP. Public delivery needs port 25 reachable from the internet.
# The sample binds loopback high-port for safe first-run testing.
# For real MX delivery use MAILFLARE_SMTP_BIND=0.0.0.0:25 and SMTP_INBOUND_PORT=25.
MAILFLARE_SMTP_BIND=127.0.0.1:2525
SMTP_INBOUND_PORT=2525
MAIL_HOSTNAME=mail.example.com

# Outbound SMTP relay, optional.
# Example: smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Cloudflare Email Sending / DNS / Email Routing automation, optional.
CF_ACCOUNT_ID=
CF_TOKEN=

# Resend provider, optional.
RESEND_API_KEY=

# Amazon SES provider, optional.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Cloudflare Email Routing relay Worker webhook, optional.
INBOUND_WEBHOOK_SECRET=

# Login/reset bot protection, optional.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OpenAI-compatible assistant provider, optional.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
