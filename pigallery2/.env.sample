# Absolute path to the existing photo library. It is mounted read-only.
PIGALLERY2_IMAGES=/absolute/path/to/photos

# The example binds only to localhost. Put a reverse proxy in front if needed.
PIGALLERY2_PORT=8088

# Set this to the externally visible HTTPS URL when using sharing links or OIDC.
PIGALLERY2_PUBLIC_URL=

# Keep false unless PiGallery2 is behind a trusted reverse proxy.
PIGALLERY2_TRUST_PROXY=false
