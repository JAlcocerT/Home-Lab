FLUXER_DOMAIN=chat.example.com
FLUXER_PUBLIC_SCHEME=https
FLUXER_PUBLIC_PORT=443

# For an existing reverse proxy on the same host, uncomment this and forward
# traffic to http://127.0.0.1:8080.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# FLUXER_EDGE_BIND=127.0.0.1:8080

# For Cloudflare Tunnel or another tunnel that terminates TLS upstream, use:
# COMPOSE_FILE=docker-compose.yml:tunnel.compose.yml
# FLUXER_HTTP_PORT=127.0.0.1:8080

FLUXER_REGISTRY_OWNER=fluxerapp
FLUXER_REGISTRY=ghcr.io/${FLUXER_REGISTRY_OWNER}
FLUXER_IMAGE_TAG=v1

POSTGRES_PASSWORD=replace-with-generated-password
MEILI_MASTER_KEY=replace-with-generated-secret
FLUXER_S3_ACCESS_KEY=fluxer
FLUXER_S3_SECRET_KEY=replace-with-generated-secret

FLUXER_SUDO_MODE_SECRET=replace-with-generated-secret
FLUXER_CONNECTION_INITIATION_SECRET=replace-with-generated-secret
FLUXER_GATEWAY_RPC_AUTH_TOKEN=replace-with-generated-secret
FLUXER_ERLANG_COOKIE=replace-with-generated-secret
FLUXER_MEDIA_PROXY_SECRET_KEY=replace-with-generated-secret
FLUXER_MEDIA_PROXY_UPLOAD_RELAY_SECRET_BASE64=replace-with-base64-secret
FLUXER_ADMIN_SECRET_KEY_BASE=replace-with-generated-secret
FLUXER_ADMIN_OAUTH_CLIENT_SECRET=replace-with-generated-secret

FLUXER_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
FLUXER_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
FLUXER_VAPID_EMAIL=admin@chat.example.com

LIVEKIT_API_KEY=fluxer
LIVEKIT_API_SECRET=replace-with-generated-secret

FLUXER_KLIPY_API_KEY=
FLUXER_EMAIL_ENABLED=false
FLUXER_EMAIL_PROVIDER=none
FLUXER_EMAIL_FROM_EMAIL=noreply@example.com
FLUXER_EMAIL_FROM_NAME=Fluxer
FLUXER_EMAIL_APP_BASE_URL=
FLUXER_EMAIL_SMTP_HOST=
FLUXER_EMAIL_SMTP_PORT=587
FLUXER_EMAIL_SMTP_USERNAME=
FLUXER_EMAIL_SMTP_PASSWORD=
FLUXER_EMAIL_SMTP_SECURE=true

FLUXER_CAPTCHA_ENABLED=false
FLUXER_CAPTCHA_PROVIDER=none
FLUXER_CAPTCHA_HCAPTCHA_SITE_KEY=
FLUXER_CAPTCHA_HCAPTCHA_SECRET_KEY=
FLUXER_CAPTCHA_TURNSTILE_SITE_KEY=
FLUXER_CAPTCHA_TURNSTILE_SECRET_KEY=
FLUXER_DISCOVERY_ENABLED=true
