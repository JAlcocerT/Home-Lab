GEOLIBRE_PORT=127.0.0.1:8097

# Optional single shared HTTP Basic Auth credential.
# Leave both empty for trusted local-only use.
GEOLIBRE_AUTH_USER=
GEOLIBRE_AUTH_PASSWORD=

# Set to 1 for the static web app only, without the Python sidecar.
GEOLIBRE_DISABLE_SIDECAR=0

# Paths the bundled conversion/Whitebox sidecar may read/write.
GEOLIBRE_CONVERSION_ROOTS=/data
