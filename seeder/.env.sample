OWNER_EMAIL=admin@example.com
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
VCS_ENCRYPTION_KEY=replace-with-a-different-openssl-rand-base64-32

# Local access URL. Change this when putting Seeder behind a reverse proxy.
BETTER_AUTH_URL=http://localhost:3031
SEEDER_PORT=3031
SEEDER_IMAGE=ghcr.io/danielsyauqi/seeder:latest

# Optional extra allowed auth origins, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=https://seeder.example.com

# Optional Google sign-in. Seeder remains invite-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional allowed browser origins for /api/mcp.
# Leave unset for non-browser MCP clients; token auth is still required.
# MCP_ALLOWED_ORIGINS=
