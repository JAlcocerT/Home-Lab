# Generate all secrets before first boot:
#   openssl rand -hex 32
# STORE_ENCRYPTION_KEY must be exactly 32 characters:
#   openssl rand -hex 16

JWT_SECRET=replace-with-a-64-character-hex-secret
STORE_ENCRYPTION_KEY=replace-with-32-character-hex-key
NOVU_SECRET_KEY=replace-with-a-64-character-hex-secret
MONGO_INITDB_ROOT_USERNAME=novu
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password

HOST_NAME=http://localhost
NODE_ENV=local

API_PORT=3000
WS_PORT=3002
WORKER_PORT=3004
DASHBOARD_PORT=4000
MONGO_PORT=27017
REDIS_PORT=6379

API_ROOT_URL=http://localhost:3000
FRONT_BASE_URL=http://localhost:4000
VITE_API_HOSTNAME=http://localhost:3000
VITE_WEBSOCKET_HOSTNAME=http://localhost:3002

MONGO_MIN_POOL_SIZE=5
MONGO_MAX_POOL_SIZE=10
MONGO_AUTO_CREATE_INDEXES=true

SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME=15d
IS_API_IDEMPOTENCY_ENABLED=false
IS_API_RATE_LIMITING_ENABLED=false
IS_NEW_MESSAGES_API_RESPONSE_ENABLED=true
IS_V2_ENABLED=true
IS_SELF_HOSTED=true
IS_EMAIL_INLINE_CSS_DISABLED=false
IS_USE_MERGED_DIGEST_ID_ENABLED=false

S3_LOCAL_STACK=http://localhost:4566
S3_BUCKET_NAME=novu-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

NEW_RELIC_ENABLED=false
NEW_RELIC_APP_NAME=
NEW_RELIC_LICENSE_KEY=
SENTRY_DSN=
BROADCAST_QUEUE_CHUNK_SIZE=100
MULTICAST_QUEUE_CHUNK_SIZE=100
