# The setup wizard creates the administrator and stores settings in ./data.
# Keep this file empty for a local-storage deployment.
CHRONOFRAME_HTTP_PORT=3802

# Optional: set a stable secret before exposing the service publicly.
# NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Optional map providers. MapLibre can work without a token when a style URL
# is configured; Mapbox features require a public and server-side token.
# NUXT_PUBLIC_MAP_PROVIDER=maplibre
# NUXT_PUBLIC_MAP_MAPLIBRE_STYLE=
# NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# NUXT_MAPBOX_ACCESS_TOKEN=
