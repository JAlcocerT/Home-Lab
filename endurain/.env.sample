# Copy to .env and replace every changeme value before deployment.
LOCAL_PATH=./data

DB_PASSWORD=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=endurain
POSTGRES_USER=endurain

SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
FERNET_KEY=changeme-generate-with-openssl-rand-base64-32
TZ=Europe/Warsaw
ENDURAIN_HOST=http://localhost:3850
BEHIND_PROXY=false
DEPLOYMENT_PROFILE=local

# Optional email for password resets and verification.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURE=true
# SMTP_SECURE_TYPE=starttls
