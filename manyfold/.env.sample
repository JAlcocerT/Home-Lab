MANYFOLD_IMAGE=ghcr.io/manyfold3d/manyfold-solo@sha256:772bcb18f0cb69d4fd0630d4676516f34fb37e42c3ac9d65eea5f173728e818e
MANYFOLD_BIND=0.0.0.0
MANYFOLD_PORT=3820
MANYFOLD_SUBNET=10.89.20.0/24

# Generate before first start:
#   openssl rand -hex 64
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64

# Match the user/group that should own files in ./config and ./models.
PUID=1000
PGID=1000

# Leave empty for http://192.168.1.2:3820 LAN testing.
# Set to the public host only when Manyfold is behind a trusted HTTPS proxy.
PUBLIC_HOSTNAME=

# Optional: enable accounts, login, roles, permissions, and registration settings.
# The default is single-user mode, where local access is effectively auto-logged-in.
# MULTIUSER=enabled

# Optional OIDC SSO variables when MULTIUSER is enabled.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
