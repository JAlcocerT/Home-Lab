RUSTFS_VERSION=1.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Replace both values before exposing RustFS outside a trusted LAN.
RUSTFS_ACCESS_KEY=replace-with-long-admin-access-key
RUSTFS_SECRET_KEY=replace-with-long-random-admin-secret-key

# Keep false for real durability. Set true only for local testing when all Docker
# volumes are on the same physical disk.
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true
RUSTFS_OBS_LOGGER_LEVEL=info
