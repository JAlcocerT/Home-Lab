OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
OPENCLAW_BIND=127.0.0.1
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_MSTEAMS_PORT=3978
OPENCLAW_GATEWAY_BIND=loopback
OPENCLAW_DISABLE_BONJOUR=1
OPENCLAW_TZ=UTC

# Required. Generate a long random value before starting the gateway.
OPENCLAW_GATEWAY_TOKEN=change-this-to-a-long-random-token

# Optional provider keys. Leave blank until you configure matching models.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

