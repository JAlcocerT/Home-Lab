POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-32
SYSTEM_ADMIN_EMAILS=admin@example.com

# Public URL of the app. Set this when using OAuth, email links, or a reverse proxy.
# BETTER_AUTH_URL=https://feedback.example.com
FEEDLOG_PORT=3030
FEEDLOG_IMAGE=ghcr.io/linkcraftstudio/feedlog:v0.5.0
AUTH_EMAIL_ENABLED=true

# Optional OAuth providers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional AI features: similar-idea detection, widget agent, AI changelog drafting.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=

# Optional transactional email.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=noreply@example.com

# Optional S3-compatible storage for uploads. Leave unset to use /app/.data.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=feedlog
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=us-east-1
# UPLOAD_PREFIX=uploads
