MAINTENANT_IMAGE=ghcr.io/kolapsis/maintenant:latest
MAINTENANT_BIND=0.0.0.0
MAINTENANT_PORT=3810
MAINTENANT_BASE_URL=http://192.168.1.2:3810
MAINTENANT_STATUS_URL=
MAINTENANT_ORGANISATION_NAME=Home Lab
MAINTENANT_DISABLE_TELEMETRY=true
MAINTENANT_CONTAINER_DOWN_AFTER=5m
MAINTENANT_PROXY_LABELS=false

# Optional paid-edition license.
MAINTENANT_LICENSE_KEY=

# Optional MCP over HTTP. If enabled, set both client values.
MAINTENANT_MCP=false
MAINTENANT_MCP_CLIENT_ID=
MAINTENANT_MCP_CLIENT_SECRET=
MAINTENANT_MCP_ALLOWED_REDIRECT_URIS=
