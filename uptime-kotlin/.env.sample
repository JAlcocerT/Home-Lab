UPTIME_KOTLIN_IMAGE=ghcr.io/theomeunier/uptime-kotlin:1.3.0
POSTGRES_IMAGE=postgres:17.4-alpine
UPTIME_KOTLIN_BIND=0.0.0.0
UPTIME_KOTLIN_PORT=3812
UPTIME_KOTLIN_MEM_LIMIT=512m
UPTIME_KOTLIN_SUBNET=10.89.12.0/24
TZ=Europe/Warsaw

POSTGRES_DB=uptime-kotlin
POSTGRES_USER=uptime-kotlin
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 32
# Keep this permanently. It encrypts stored secrets and the JWT signing key.
ENCRYPTION_MASTER_KEY=replace-with-openssl-rand-base64-32
ENCRYPTION_PREVIOUS_MASTER_KEYS=

MP_JWT_VERIFY_ISSUER=http://192.168.1.2:3812
SCHEDULER_STRATEGY=database
SCHEDULER_WORKER_CONCURRENCY=4
MAINTENANCE_HORIZON_DAYS=90
MAINTENANCE_MAX_DURATION_HOURS=24
NOTIFICATIONS_DISPLAY_TIMEZONE=Europe/Warsaw
