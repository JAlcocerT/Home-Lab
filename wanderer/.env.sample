WANDERER_VERSION=v0.21.0
ORIGIN=http://192.168.1.2:3815

# Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=replace-with-a-long-random-meilisearch-key

# Generate with: openssl rand -hex 16
POCKETBASE_ENCRYPTION_KEY=replace-with-32-hex-characters

# Generate with: openssl rand -hex 32
POCKETBASE_PROXY_SECRET=replace-with-64-hex-characters

# Set true after creating the first account if you do not want open signups.
PUBLIC_DISABLE_SIGNUP=false

# Optional hosted defaults. Replace with self-hosted endpoints if you operate them.
OVERPASS_API_URL=https://overpass-api.de
VALHALLA_URL=https://valhalla1.openstreetmap.de
NOMINATIM_URL=https://nominatim.openstreetmap.org
PUBLIC_MAP_MAX_POLYLINES=100
