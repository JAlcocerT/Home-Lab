DBACKUP_PORT=3802

# Generate once and keep forever:
# openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-character-hex-key

# Generate once and keep forever:
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-base64-auth-secret

# Must match the URL users open in the browser.
BETTER_AUTH_URL=http://192.168.1.2:3802

# Optional, comma-separated extra access URLs.
TRUSTED_ORIGINS=http://localhost:3802

# Set false only if you want DBackup to serve HTTPS directly.
DISABLE_HTTPS=true

TZ=Europe/Warsaw
PUID=1001
PGID=1001
