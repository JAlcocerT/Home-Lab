SLITE_PORT=5483

# Required. Use a private value with at least 8 characters and no whitespace.
NUXT_SITE_TOKEN=replace-with-a-long-private-token

# Reverse proxy settings. Keep false unless all traffic reaches Slite through
# a proxy that rewrites forwarded headers.
NUXT_TRUST_PROXY=false
NUXT_CLIENT_IP_HEADER=

# Optional public behavior.
NUXT_PUBLIC_HOME_URL=
NUXT_NOT_FOUND_REDIRECT=
NUXT_REDIRECT_STATUS_CODE=301
NUXT_REDIRECT_WITH_QUERY=false
NUXT_REDIRECT_NO_STORE=false
NUXT_CASE_SENSITIVE=false
NUXT_PUBLIC_LINK_PROXY_ENABLED=false

# Optional analytics/storage behavior.
NUXT_DISABLE_BOT_ACCESS_LOG=false
NUXT_DISABLE_AUTO_BACKUP=false
NUXT_GEOIP_PATH=
NUXT_SAFE_BROWSING_DOH=

# Optional click webhook.
NUXT_WEBHOOK_URL=
NUXT_WEBHOOK_SECRET=

# Optional AI provider. Leave empty to disable AI endpoints.
NUXT_AI_BASE_URL=
NUXT_AI_MODEL=
NUXT_AI_API_KEY=
