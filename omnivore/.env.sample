POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=omnivore
PGPASSWORD=change-this-postgres-password
PG_HOST=localhost
PG_PASSWORD=change-this-app-password
PG_DB=omnivore
PG_USER=app_user
PG_PORT=5432
PG_POOL_MAX=20

API_ENV=local
APP_ENV=prod
JWT_SECRET=replace-with-a-long-random-value
SSO_JWT_SECRET=replace-with-another-long-random-value
VERIFICATION_TOKEN=replace-with-a-random-token
AUTO_VERIFY=true
ENABLE_EMAIL_SIGNUP=true

BASE_URL=http://192.168.1.2:3010
CLIENT_URL=http://192.168.1.2:3010
HIGHLIGHTS_BASE_URL=http://192.168.1.2:3010
SERVER_BASE_URL=http://192.168.1.2:4010
GATEWAY_URL=http://localhost:8080/api
REST_BACKEND_ENDPOINT=http://localhost:8080/api

GCS_USE_LOCAL_HOST=true
GCS_UPLOAD_BUCKET=omnivore
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=miniominio
AWS_REGION=us-east-1
LOCAL_MINIO_URL=http://localhost:1010
SKIP_UPLOAD_ORIGINAL=true

CONTENT_FETCH_QUEUE_ENABLED=true
RUN_DISCOVER_AS_WORKER=true
RUN_CONTENT_FETCH_AS_WORKER=true
RUN_QUEUE_AS_WORKER=true
WATCHER_API_KEY=replace-if-email-ingestion-is-enabled
REDIS_URL=redis://redis:6379/0
MQ_REDIS_URL=redis://redis:6379/0
