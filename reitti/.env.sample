REITTI_VERSION=5
REITTI_BIND=0.0.0.0
REITTI_PORT=3814
REITTI_SUBNET=10.89.14.0/24

POSTGIS_IMAGE=postgis/postgis:17-3.5-alpine
POSTGIS_USER=reitti
POSTGIS_PASSWORD=replace-with-a-long-random-password
POSTGIS_DB=reittidb

BASE_PATH=/
ADVERTISE_URI=http://192.168.1.2:3814
TILES_CACHE=http://tile-cache
JAVA_OPTS=-Xmx768m -Xms256m

OIDC_ENABLED=false
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Enables destructive data-management tools in the UI. Keep false unless you know why.
DANGEROUS_LIFE=false

# H3/spatial coverage feature. Leave false for a light homelab setup.
SPATIAL_COVERAGE=false
