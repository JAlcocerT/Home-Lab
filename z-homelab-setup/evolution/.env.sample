
### For Nextcloud 2602
# MariaDB Configuration
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=ncpass
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud

# Nextcloud Configuration
MYSQL_HOST=nextclouddb
NEXTCLOUD_TRUSTED_DOMAINS=
#https://nc.piszymszu.duckdns.org/ #http://[IP_ADDRESS]

### For Nextcloud Sync
# MariaDB Configuration
MYSQL_ROOT_PASSWORD_SYNC=rootpass-sync
MYSQL_PASSWORD_SYNC=ncpass-sync
MYSQL_DATABASE_SYNC=nextcloud_sync
MYSQL_USER_SYNC=nextcloud_sync

# Nextcloud Configuration
MYSQL_HOST_SYNC=nextclouddb-sync
NEXTCLOUD_TRUSTED_DOMAINS_SYNC=
#http://192.168.1.2:8069

### Termix
# Generate: openssl rand -base64 24 | tr -d '=+/' | cut -c1-32
TERMIX_SALT=changeme

### Neko (remote browser)
NEKO_USER_PASSWORD=changeme
NEKO_ADMIN_PASSWORD=changeme_admin
# LAN IP of the Docker host — shown to WebRTC clients for NAT traversal
NEKO_HOST_IP=192.168.1.12
