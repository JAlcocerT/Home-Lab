# Copy to .env before starting:
#   cp .env.sample .env
#
# Generate strong values:
#   openssl rand -hex 64
#   openssl rand -hex 32
#   openssl genrsa 2048 | openssl base64 -A

POSTGRES_DB=lago
POSTGRES_USER=lago
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PORT=5432

API_PORT=3007
FRONT_PORT=8087
LAGO_API_URL=http://localhost:3007
LAGO_FRONT_URL=http://localhost:8087

SECRET_KEY_BASE=replace-with-openssl-rand-hex-64
LAGO_RSA_PRIVATE_KEY=replace-with-openssl-genrsa-2048-base64
LAGO_ENCRYPTION_PRIMARY_KEY=replace-with-openssl-rand-hex-32
LAGO_ENCRYPTION_DETERMINISTIC_KEY=replace-with-openssl-rand-hex-32
LAGO_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-openssl-rand-hex-32

LAGO_DISABLE_SEGMENT=true
LAGO_DISABLE_SIGNUP=false
LAGO_DISABLE_PDF_GENERATION=false

# Optional first-organization bootstrap. Leave disabled unless you want a seeded local org.
LAGO_CREATE_ORG=false
LAGO_ORG_USER_EMAIL=
LAGO_ORG_USER_PASSWORD=
LAGO_ORG_NAME=
LAGO_ORG_API_KEY=

# Optional SMTP for invoice and account emails.
LAGO_FROM_EMAIL=
LAGO_SMTP_ADDRESS=
LAGO_SMTP_PORT=587
LAGO_SMTP_USERNAME=
LAGO_SMTP_PASSWORD=

# Optional object storage. Local Active Storage is used when both providers are disabled.
LAGO_USE_AWS_S3=false
LAGO_AWS_S3_ACCESS_KEY_ID=
LAGO_AWS_S3_SECRET_ACCESS_KEY=
LAGO_AWS_S3_REGION=us-east-1
LAGO_AWS_S3_BUCKET=
LAGO_AWS_S3_ENDPOINT=
LAGO_USE_GCS=false
LAGO_GCS_PROJECT=
LAGO_GCS_BUCKET=

# Optional OAuth and premium/license settings.
LAGO_OAUTH_PROXY_URL=https://proxy.getlago.com
LAGO_LICENSE=
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
