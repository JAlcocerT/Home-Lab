GROWCHIEF_VERSION=v0.3.0
GROWCHIEF_HTTP_PORT=5002

GROWCHIEF_DB_NAME=growchief
GROWCHIEF_DB_USER=growchief
GROWCHIEF_DB_PASSWORD=replace-me-growchief-db-password

AUTH_SECRET=replace-me-long-random-auth-secret
FRONTEND_URL=http://localhost:5002
VITE_BACKEND_URL=/api
VITE_PUBLIC_WS=http://localhost:5002
DISABLE_REGISTRATION=

TEMPORAL_NAMESPACE=default
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=replace-me-temporal-db-password
TEMPORAL_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:5002

STORAGE_PROVIDER=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APOLLO_API_KEY=
DATAGMA_API_KEY=
BRIGHTDATA_CUSTOMER=
BRIGHTDATA_API_KEY=
OPENAI_KEY=
