POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=replace-with-a-random-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Local ports. Keep these on loopback unless you put Ente behind HTTPS.
ENTE_API_PORT=8080
ENTE_PHOTOS_PORT=3000
ENTE_ACCOUNTS_PORT=3001
ENTE_ALBUMS_PORT=3002
ENTE_AUTH_PORT=3003
ENTE_CAST_PORT=3004
ENTE_SHARE_PORT=3005
ENTE_EMBED_PORT=3006
ENTE_PASTE_PORT=3008
ENTE_LOCKER_PORT=3009
ENTE_MEMORIES_PORT=3010
MINIO_API_PORT=3200
MINIO_CONSOLE_PORT=3201

# This is injected into the web bundle at container startup.
ENTE_API_ORIGIN=http://localhost:8080
