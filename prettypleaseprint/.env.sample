PPP_REGISTRY=ghcr.io/danileau
PPP_TAG=fcadf1c
PPP_BIND=0.0.0.0
PPP_PORT=3819
PPP_SUBNET=10.89.19.0/24

# The app requires HTTPS in production, except for localhost. This compose puts
# Caddy in front with an internal/self-signed certificate for LAN testing.
# Your browser will likely show a certificate warning until you trust the CA.
APP_URL=https://192.168.1.2:3819

# Generate real values before first start:
#   openssl rand -base64 32
#   openssl rand -hex 24
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
DB_PASSWORD=replace-with-openssl-rand-hex-24

# Passkeys need a secure context and are best used with a real HTTPS domain.
# Username/password is the practical LAN trial path with the self-signed cert.
PASSKEY_RP_ID=192.168.1.2
PASSKEY_RP_NAME=Pretty Please Print

ADMIN_EMAIL=you@example.org
ADMIN_NAME=Your Name

# Email is optional. Leave SMTP_URL empty and the app shows invite/reset links
# on screen or in logs. To use Mailpit, start with --profile mailcatcher and
# set SMTP_URL=smtp://mailpit:1025.
MAIL_FROM=Pretty Please Print <printer@example.org>
SMTP_URL=
RESEND_API_KEY=

TRUST_PROXY_HEADERS=false
HIBP_DISABLED=false
IMPORT_SOURCES=
SOURCE_URL=https://github.com/danileau/prettypleaseprint
