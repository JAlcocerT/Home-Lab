NETWORKING_TOOLBOX_PORT=6162

# Optional instance branding and defaults
NTB_SITE_TITLE=Networking Toolbox
NTB_SITE_DESCRIPTION=Internal networking utilities
NTB_DEFAULT_THEME=ocean
NTB_HOMEPAGE_LAYOUT=categories
NTB_DISABLE_SETTINGS=false

# Disable hosted analytics by default for self-hosted use
NTB_ANALYTICS_DOMAIN=false
NTB_ANALYTICS_DSN=false

# Keep custom resolver input locked down unless you understand the SSRF risk
NTB_ALLOW_CUSTOM_DNS=false
NTB_BLOCK_PRIVATE_DNS_IPS=true
