# GitHub credentials
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_yourGitHubPAT

# Forgejo instance
FORGEJO_URL=http://localhost:3034
FORGEJO_TOKEN=your-forgejo-api-token

# Used for single-repo targets
REPO_OWNER=your-github-username
REPO_NAME=your-repo-name

# Used for user management targets
NEW_USER=newusername
NEW_USER_EMAIL=user@example.com
NEW_USER_PASSWORD=changeme123
