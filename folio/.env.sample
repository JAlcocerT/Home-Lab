FOLIO_IMAGE=ghcr.io/evergreen-it-dev/folio:latest
FOLIO_PORT=4870
FOLIO_BIND=0.0.0.0
PUBLIC_URL=http://192.168.1.2:4870

# Generate once:
# openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional. Leave empty and Folio generates it on first start in folio-data.
# If you set it yourself, keep it forever because it encrypts saved Git tokens
# and personal AI keys.
# openssl rand -hex 32
FOLIO_SECRET=

# Optional Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAINS=

# Optional AI assistant fallback. Users can also add their own Cursor key.
CURSOR_API_KEY=
CURSOR_AGENT_MODEL=auto

# Optional analytics for public demos only. Empty means no telemetry.
FOLIO_POSTHOG_KEY=
FOLIO_POSTHOG_HOST=

# Set true behind a trusted reverse proxy so rate limiting uses the real client IP.
TRUST_PROXY=
